# 本地开发用数据库连接串（docker-compose 的 PostgreSQL）
DATABASE_URL=postgresql://vlab:vlab_dev_password@localhost:5432/virtual_biology_lab
# JWT 签名密钥，生产环境必须 >= 16 字符的随机值；本地开发可省略（使用弱默认值，禁止用于生产）
JWT_SECRET=

# 运行环境：production 时启用严格环境变量校验（DATABASE_URL / JWT_SECRET 缺失则拒绝启动）
NODE_ENV=development
# 集成测试专用库（可选；不设置则跳过集成测试）
# TEST_DATABASE_URL=postgresql://vlab:vlab_dev_password@localhost:5432/virtual_biology_lab_test
# API 端口
PORT=3000

# -- AI Provider（可选，默认 mock 离线可用）--
# mock | openai-compatible
# AI_PROVIDER=mock
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# -- Storage Provider（占位，后续迭代实现运行时读取）--
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=

{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "include": ["packages/**/src/**", "packages/**/tests/**", "apps/**/src/**", "apps/**/tests/**"],
    "ignore": ["**/dist/**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": ["packages/**/tests/**", "apps/**/tests/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "performance": { "noDelete": "off" }
        }
      }
    },
    {
      "include": ["apps/**/src/**"],
      "linter": {
        "rules": {
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}

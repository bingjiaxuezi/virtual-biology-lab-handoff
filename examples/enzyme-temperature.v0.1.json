{
  "schemaVersion": "0.1",
  "id": "exp_enzyme_temperature",
  "version": 1,
  "metadata": {
    "title": "温度对酶活性的影响",
    "description": "研究不同温度条件下酶活性变化。",
    "subject": "生物",
    "gradeLevel": "高中",
    "tags": ["酶", "温度", "对照实验"]
  },
  "teaching": {
    "objectives": [
      "理解温度对酶活性的影响",
      "观察高温导致酶活性下降的现象"
    ],
    "durationMinutes": 30,
    "prerequisites": ["了解酶的基本概念"]
  },
  "variables": [
    {
      "id": "temperature",
      "name": "温度",
      "type": "NUMBER",
      "defaultValue": 25,
      "min": 0,
      "max": 100,
      "unit": "℃"
    },
    {
      "id": "sampleStatus",
      "name": "样本状态",
      "type": "ENUM",
      "defaultValue": "NORMAL",
      "options": ["NORMAL", "DENATURED"]
    }
  ],
  "assets": [
    {
      "id": "normal_video",
      "assetId": "asset_normal_video",
      "type": "VIDEO",
      "name": "正常温度下的反应现象"
    },
    {
      "id": "denatured_video",
      "assetId": "asset_denatured_video",
      "type": "VIDEO",
      "name": "高温失活现象"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "label": "开始"
    },
    {
      "id": "set_temp",
      "type": "VARIABLE_INPUT",
      "label": "设置实验温度",
      "config": {
        "variableId": "temperature",
        "inputMode": "SLIDER"
      }
    },
    {
      "id": "check_temp",
      "type": "CONDITION",
      "label": "判断温度是否超过 60℃",
      "config": {
        "condition": {
          "variableId": "temperature",
          "operator": "GT",
          "value": 60
        }
      }
    },
    {
      "id": "normal_media",
      "type": "MEDIA",
      "label": "正常反应现象",
      "config": {
        "assetId": "asset_normal_video",
        "mediaType": "VIDEO",
        "caption": "适宜温度下酶促反应正常进行"
      }
    },
    {
      "id": "denatured_media",
      "type": "MEDIA",
      "label": "高温失活现象",
      "config": {
        "assetId": "asset_denatured_video",
        "mediaType": "VIDEO",
        "caption": "高温导致酶变性失活"
      }
    },
    {
      "id": "observe",
      "type": "OBSERVATION",
      "label": "记录实验现象",
      "config": {
        "prompt": "描述你观察到的实验现象",
        "placeholder": "例如：颜色变化、气泡产生情况……"
      }
    },
    {
      "id": "end_normal",
      "type": "END",
      "label": "实验完成（正常）",
      "config": {
        "outcome": "NORMAL"
      }
    },
    {
      "id": "end_denatured",
      "type": "END",
      "label": "实验完成（酶失活）",
      "config": {
        "outcome": "DENATURED"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "set_temp"
    },
    {
      "id": "t2",
      "from": "set_temp",
      "to": "check_temp"
    },
    {
      "id": "t3",
      "from": "check_temp",
      "to": "denatured_media",
      "condition": {
        "variableId": "temperature",
        "operator": "GT",
        "value": 60
      },
      "priority": 10
    },
    {
      "id": "t4",
      "from": "check_temp",
      "to": "normal_media",
      "condition": {
        "variableId": "temperature",
        "operator": "LTE",
        "value": 60
      },
      "priority": 5
    },
    {
      "id": "t5",
      "from": "denatured_media",
      "to": "observe"
    },
    {
      "id": "t6",
      "from": "normal_media",
      "to": "observe"
    },
    {
      "id": "t7",
      "from": "observe",
      "to": "end_normal",
      "condition": {
        "variableId": "sampleStatus",
        "operator": "EQ",
        "value": "NORMAL"
      },
      "priority": 10
    },
    {
      "id": "t8",
      "from": "observe",
      "to": "end_denatured",
      "condition": {
        "variableId": "sampleStatus",
        "operator": "EQ",
        "value": "DENATURED"
      },
      "priority": 5
    }
  ],
  "rules": [
    {
      "id": "r_high_temp",
      "when": {
        "variableId": "temperature",
        "operator": "GT",
        "value": 60
      },
      "effects": [
        {
          "type": "SET",
          "variableId": "sampleStatus",
          "value": "DENATURED"
        },
        {
          "type": "SCORE",
          "value": 10
        }
      ]
    },
    {
      "id": "r_normal_temp",
      "when": {
        "variableId": "temperature",
        "operator": "LTE",
        "value": 60
      },
      "effects": [
        {
          "type": "SET",
          "variableId": "sampleStatus",
          "value": "NORMAL"
        },
        {
          "type": "SCORE",
          "value": 20
        }
      ]
    }
  ],
  "assessment": {
    "initialScore": 0,
    "completion": {
      "type": "REACH_END"
    },
    "summary": {
      "showScore": true,
      "showKeyEvents": true
    }
  },
  "aiPolicy": {
    "briefing": {
      "enabled": true
    },
    "tutor": {
      "enabled": true,
      "hintLevel": "STANDARD",
      "allowExplainTheory": true,
      "allowPointOutWrongDirection": false,
      "revealAnswer": false
    },
    "observationAssist": {
      "enabled": true
    },
    "review": {
      "enabled": true
    }
  }
}

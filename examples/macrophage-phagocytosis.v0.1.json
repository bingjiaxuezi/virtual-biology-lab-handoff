{
  "schemaVersion": "0.1",
  "id": "macrophage-phagocytosis",
  "version": 1,
  "metadata": {
    "title": "小鼠腹腔巨噬细胞吞噬鸡红细胞实验",
    "description": "通过交互式视频还原经典吞噬实验与荧光微球定量实验，在关键操作点做出选择并观察正误结果，理解巨噬细胞吞噬作用的实验设计与规范操作。",
    "author": "生物实验教学组",
    "subject": "免疫学/细胞生物学",
    "gradeLevel": "大学",
    "tags": ["巨噬细胞", "吞噬作用", "鸡红细胞", "荧光微球", "交互式视频"]
  },
  "teaching": {
    "objectives": [
      "掌握小鼠抓取、腹腔注射、解剖取液的规范操作",
      "理解染色、盖片、镜检的正确方法与常见错误",
      "能辨认被吞噬的鸡红细胞并描述吞噬现象",
      "了解荧光微球定量吞噬实验的流程与结果判读"
    ],
    "prerequisites": ["巨噬细胞与吞噬作用的基本概念", "显微镜的基本使用"],
    "durationMinutes": 40
  },
  "variables": [
    {
      "id": "grip_site",
      "name": "抓取小鼠的部位",
      "type": "ENUM",
      "options": ["前臂后侧皮肤", "背部皮肤", "颈后（头后侧）皮肤"],
      "defaultValue": "前臂后侧皮肤"
    },
    {
      "id": "dissect_tools",
      "name": "解剖器械选择",
      "type": "ENUM",
      "options": ["只选剪刀", "只选镊子", "剪刀和镊子"],
      "defaultValue": "只选剪刀"
    },
    {
      "id": "stain_amount",
      "name": "染色液用量",
      "type": "ENUM",
      "options": ["超大滴", "大滴", "适中一滴"],
      "defaultValue": "超大滴"
    },
    {
      "id": "coverslip_method",
      "name": "盖片方式",
      "type": "ENUM",
      "options": ["大滴染色只用盖玻片", "先推片再盖玻片", "染色适中后直接盖片"],
      "defaultValue": "大滴染色只用盖玻片"
    },
    {
      "id": "lens_choice",
      "name": "物镜选择",
      "type": "ENUM",
      "options": ["直接使用高倍镜", "先低倍镜再高倍镜"],
      "defaultValue": "直接使用高倍镜"
    },
    {
      "id": "phagocytosed_cell",
      "name": "被吞噬的鸡红细胞是哪一个",
      "type": "ENUM",
      "options": ["细胞外游离的鸡红细胞", "深蓝色的巨噬细胞核", "被吞入巨噬细胞内的鸡红细胞"],
      "defaultValue": "细胞外游离的鸡红细胞"
    },
    {
      "id": "scene_choice",
      "name": "实验场景",
      "type": "ENUM",
      "options": ["荧光微球定量吞噬实验"],
      "defaultValue": "荧光微球定量吞噬实验"
    },
    {
      "id": "keep_component",
      "name": "离心后保留的成分",
      "type": "ENUM",
      "options": ["上清液", "细胞沉淀"],
      "defaultValue": "上清液"
    },
    {
      "id": "pbs_site",
      "name": "加入 PBS 的部位",
      "type": "ENUM",
      "options": ["直接滴加在细胞上", "沿孔壁缓慢加入"],
      "defaultValue": "直接滴加在细胞上"
    },
    {
      "id": "keep_part",
      "name": "二次离心后保留的部分",
      "type": "ENUM",
      "options": ["上清液", "细胞沉淀"],
      "defaultValue": "上清液"
    }
  ],
